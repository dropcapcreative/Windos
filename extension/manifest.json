{
  "manifest_version": 3,
  "name": "Retrowave Visualizer for YouTube",
  "short_name": "Retrowave",
  "version": "1.0.0",
  "description": "Brings back old-school media player visualizations: they play over YouTube and YouTube Music when music is on.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Retrowave Visualizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["visualizer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
